{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>stevewm/renovate-config:default.json5',
    'github>stevewm/homelab//.github/renovate/autoMerge.json5',
    'github>stevewm/homelab//.github/renovate/branchPrefixes.json5',
    'github>stevewm/homelab//.github/renovate/groups.json5',
    'github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0',
  ],
  schedule: ['* 17-23 * * 5', '* 0-23 * * 6', '* 0-23 * * 7'],
  flux: {
    managerFilePatterns: ['/(^|/)cluster/kubernetes/.+\\.ya?ml$/'],
  },
  'helm-values': {
    managerFilePatterns: ['/(^|/)cluster/kubernetes/.+\\.ya?ml$/'],
  },
  kubernetes: {
    managerFilePatterns: ['/(^|/)cluster/kubernetes/.+\\.ya?ml$/'],
  },
}
