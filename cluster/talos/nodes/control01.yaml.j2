---
machine:
  install:
    diskSelector:
      model: "Patriot M.2 P320 256GB"
  nodeLabels:
    node.kubernetes.io/gpu: "true"
  type: controlplane
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: local-hostpath
provisioning:
  diskSelector:
    match: disk.model == "CT2000P3SSD8" && !system_disk
  grow: true
  minSize: 1TB
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: control01
