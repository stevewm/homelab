amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local config = ".github/linters"
local linters = new Mapping<String, Step> {
  // builtins
  ["actionlint"] = Builtins.actionlint
  ["hadolint"] = Builtins.hadolint
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["newlines"] = Builtins.newlines
  ["shebangs"] = Builtins.check_executables_have_shebangs
  ["mise"] = Builtins.mise
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["tofu"] = Builtins.tofu
  ["zizmor"] = Builtins.zizmor

  ["ruff"] = (Builtins.ruff) {
    check = "ruff check --config " + config + "/ruff.toml {{ files }}"
    fix = "ruff check --config " + config + "/ruff.toml --fix {{ files }}"
  }

  ["oxfmt"] = (Builtins.oxfmt) {
    check = "oxfmt --config " + config + "/.oxfmtrc.json --check {{ files }}"
    check_list_files = "oxfmt --list-different {{ files }}"
    fix = "oxfmt --config " + config + "/.oxfmtrc.json --write {{ files }}"
    exclude = List(".mise.toml", ".mise/**") // Clashes with mise fmt
  }

  ["rumdl"] = (Builtins.rumdl) {
    check = "rumdl check --config " + config + "/rumdl.toml {{ files }}"
    fix = "rumdl fmt --config " + config + "/rumdl.toml {{ files }}"
  }

  ["dclint"] = (Builtins.dclint) {
    check = "dclint {{ files }} --config " + config + "/dclint.yaml"
    fix = "dclint {{ files }} --config " + config + "/dclint.yaml --fix"
  }

  ["renovate-config"] {
    glob = List(".github/renovate.json5", ".github/renovate/*.json5")
    check = "renovate-config-validator {{ files }}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }

  // "fix" and "check" are special steps for `hk fix` and `hk check` commands
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
